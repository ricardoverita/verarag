# Copy this file to .env (`cp .env.example .env`). .env is ignored by git.
#
# These values only make sense for local development. Use your own secrets
# anywhere else. Passwords end up inside connection URLs, so keep them to
# letters, digits, '-' and '_'.

# PostgreSQL
POSTGRES_USER=verarag
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_DB=verarag

# Redis (provisioned, not used by the services yet)
REDIS_PASSWORD=local-redis-password

# MinIO, the S3-compatible storage used in development.
# The password needs at least 8 characters.
MINIO_ROOT_USER=verarag
MINIO_ROOT_PASSWORD=local-minio-password
S3_BUCKET=verarag-documents

# Application
# "development" allows what only makes sense on localhost: session cookies
# without the Secure flag and the development endpoints. Leaving it empty
# means production rules; values other than development, test or production
# stop the API at startup.
APP_ENV=development
# One of: debug, info, warn, error.
LOG_LEVEL=info
# Mounts POST /api/v1/dev/events to check the API -> NATS -> worker flow.
# Never enable it outside local development.
DEV_ENDPOINTS_ENABLED=true
# API documentation at /api/docs. Leave empty for the default: on in
# development, off in production.
OPENAPI_ENABLED=

# Observability profile (`docker compose --profile observability up`).
# Set the endpoint to http://jaeger:4318 to send traces to Jaeger; leave it
# empty to keep tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=local-grafana-password

# Ports published on 127.0.0.1. Change them if they clash with something
# already running on your machine.
WEB_PORT=3000
# Public URL of the web app, as typed in the browser. Defaults to
# http://localhost:${WEB_PORT}. Requests from any other origin are refused.
WEB_PUBLIC_URL=
API_PORT=3001
POSTGRES_PORT=5432
NATS_PORT=4222
NATS_MONITOR_PORT=8222
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
JAEGER_UI_PORT=16686
